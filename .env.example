# Banco de dados (ver docker-compose.yml para subir um Postgres local)
DATABASE_URL="postgresql://vigiagov:vigiagov@localhost:5432/vigiagov?schema=public"

# API
PORT=3333
# Chave exigida no header `x-admin-key` para disparar sincronizações manuais.
ADMIN_API_KEY="troque-por-uma-chave-forte"
# Expressão cron para a sincronização federal automática (padrão: diária às 04:00).
SYNC_CRON_FEDERAL="0 4 * * *"
# Opcional: força a sincronização eleitoral do TSE para um ano específico,
# independente da detecção automática de ano eleitoral.
# ANO_ELEICAO_ATUAL=2026

# Frontend (apps/web)
VITE_API_URL="http://localhost:3333"
